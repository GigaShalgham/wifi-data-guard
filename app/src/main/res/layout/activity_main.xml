<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wi-Fi Data Guard"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:typeface="monospace"
            android:textSize="14sp"
            android:text="…"/>

        <EditText
            android:id="@+id/etLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:inputType="numberDecimal"
            android:hint="Wi-Fi limit in MB (e.g. 750)"/>

        <CheckBox
            android:id="@+id/cbMonthly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset monthly (otherwise daily)"/>

        <CheckBox
            android:id="@+id/cbHard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hard mode: block ALL internet via VPN while locked"/>
        <Button
            android:id="@+id/btnLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 فارسی"/>
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save limit"/>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset usage counter"/>

        <ProgressBar
            android:id="@+id/pbUsage"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100"/>

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unlock (requires PIN)"/>

        <Button
            android:id="@+id/btnGrant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fix permissions"/>

        <Button
            android:id="@+id/btnOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device-owner setup guide (adb)"/>

        <Button
            android:id="@+id/btnPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set / change PIN"/>

        <Button
            android:id="@+id/btnLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View logs"/>

        <Switch
            android:id="@+id/swMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enforce limit (requires PIN to disable)"/>
    </LinearLayout>
</ScrollView>