<?xml version="1.0" encoding="utf-8"?><!--
   Wi-Fi Data Guard: never back up or transfer the PIN hash, preferences or logs.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="guard_prefs.xml" />
        <exclude domain="file" path="guard_log.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="guard_prefs.xml" />
        <exclude domain="file" path="guard_log.txt" />
    </device-transfer>
</data-extraction-rules>
