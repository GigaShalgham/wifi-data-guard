<?xml version="1.0" encoding="utf-8"?><!--
   Wi-Fi Data Guard: never back up the PIN hash, preferences or logs.
   The manifest also sets android:allowBackup="false"; these rules are a
   second line of defence in case that flag is ever flipped back.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="guard_prefs.xml" />
    <exclude domain="file" path="guard_log.txt" />
</full-backup-content>
